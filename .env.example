# ==============================================================================
# EuVerso Website Institucional — Variáveis de Ambiente
# ==============================================================================

# URL canônica pública do website (usada em canonical, sitemap.xml, robots.txt e Open Graph)
NEXT_PUBLIC_SITE_URL=https://euverso.com

# Número comercial oficial do WhatsApp (apenas DDI + DDD + número, sem espaços ou símbolos)
# Exemplo de formato: 5511999999999
# IMPORTANTE: Deixar vazio até confirmar o número oficial antes da publicação.
# Quando vazio, o site abre o fluxo comercial orientativo/contato sem inventar número.
NEXT_PUBLIC_WHATSAPP_NUMBER=
WHATSAPP_NUMBER=

# Identificador opcional de analytics (carregado somente após consentimento explícito LGPD)
NEXT_PUBLIC_ANALYTICS_DEBUG=false
